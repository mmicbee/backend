# ==============================================================================
# LMS Backend Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Copy this file to `.env` for local development: `cp .env.example .env`
# - NEVER commit real credentials, secrets, or production keys to version control.
# - The `.env` file is excluded in .gitignore and .dockerignore.
# - For production deployments, inject secrets via Kubernetes Secrets, AWS Secrets
#   Manager, Google Secret Manager, or HashiCorp Vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Supabase direct connection (db.<project-ref>.supabase.co:5432) is IPv6-only by default.
# Use Supabase's free Session Pooler connection (IPv4-compatible):
# e.g., aws-0-<region>.pooler.supabase.com:6543 (or :5432 session mode)
# Username format for pooler: postgres.<project-ref>
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# Basic Security Configuration
# ------------------------------------------------------------------------------
SPRING_SECURITY_USERNAME=admin
SPRING_SECURITY_PASSWORD=change_this_admin_password_in_production

# ------------------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------------------
# [SENSITIVE] Must be a cryptographically secure random string of at least 32 characters
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long_12345
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Google OAuth2 Authentication (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=optional_google_client_id
# [SENSITIVE]
GOOGLE_CLIENT_SECRET=optional_google_client_secret

# ==============================================================================
# PAYMENT API CONFIGURATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Paystack API Configuration
# ------------------------------------------------------------------------------
# [CRITICAL SECRET] Secret key used for authenticating to Paystack REST API
# and for verifying incoming webhook signatures (HMAC-SHA512).
# Format: sk_test_... (sandbox) or sk_live_... (production)
PAYSTACK_SECRET_KEY=sk_test_optional_paystack_secret_key

# [PUBLIC KEY] Public key used on client/checkout side.
# Format: pk_test_... (sandbox) or pk_live_... (production)
PAYSTACK_PUBLIC_KEY=pk_test_optional_paystack_public_key

# [CONFIGURATION] Paystack API base URL (defaults to https://api.paystack.co)
PAYSTACK_BASE_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 2. Safaricom M-Pesa (Daraja API) Configuration
# ------------------------------------------------------------------------------
# [CONFIDENTIAL] Daraja Consumer Key (also supported as MPESA_APP_KEY)
MPESA_CONSUMER_KEY=optional_mpesa_consumer_key

# [CRITICAL SECRET] Daraja Consumer Secret used for OAuth token generation
# (also supported as MPESA_APP_SECRET)
MPESA_CONSUMER_SECRET=optional_mpesa_consumer_secret

# [CRITICAL SECRET] Passkey used to generate encrypted STK Push password
MPESA_PASSKEY=optional_mpesa_online_passkey

# [CONFIGURATION] Business Short Code (Paybill or Till Number)
MPESA_BUSINESS_SHORTCODE=174379

# [CONFIGURATION] Sender Short Code (if different from Business Short Code)
MPESA_SENDER_SHORT_CODE=174379

# [CONFIGURATION] Environment: "sandbox" for testing, "production" for live
MPESA_ENV=sandbox

# [CONFIGURATION] Publicly accessible webhook callback URL for M-Pesa IPN
MPESA_CALLBACK_URL=http://localhost:8080/api/mpesa/callback

# [CONFIGURATION] Timeout callback URL
MPESA_TIMEOUT_URL=http://localhost:8080/api/mpesa/timeout

# [CONFIGURATION] Transaction query result URL
MPESA_RESULT_URL=http://localhost:8080/api/mpesa/result

# [CONFIDENTIAL] Initiator name for B2C/B2B or status query requests
MPESA_INITIATOR_NAME=optional_initiator_name

# [CRITICAL SECRET] Security credential for initiator (encrypted certificate password)
MPESA_SECURITY_CREDENTIAL=optional_security_credential

# ------------------------------------------------------------------------------
# Mail Configuration for OTP / Notifications (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=optional@example.com
# [SENSITIVE]
SMTP_PASSWORD=optional_smtp_password
